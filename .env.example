COUCHDB_URL=http://127.0.0.1:5984
COUCHDB_DB=obsidian_notes
COUCHDB_USER=yourusername
COUCHDB_PASSWORD=password
FLASK_PORT=5000
# SSL verification for HTTPS CouchDB connections.
# true (default) = verify against system CA bundle
# false          = skip verification (self-signed certs, not recommended in production)
# /path/to/ca.crt = verify against a specific CA bundle file
COUCHDB_VERIFY_SSL=true
# Passphrase used in Obsidian LiveSync plugin settings (leave blank if encryption is off)
LIVESYNC_PASSPHRASE=
# Local folder used to cache markdown files at server startup
LOCAL_CACHE_DIR=./local_markdown_cache
# Optional PBKDF2 salt for HKDF format '%=' chunks.
# Set this only if your data uses '%=' and decryption debug reports missing salt.
# Accepts hex or base64.
LIVESYNC_PBKDF2_SALT=
